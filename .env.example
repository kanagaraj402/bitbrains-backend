# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=bitbrains

# Frontend origin allowed to call this API (Vite default)
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Used once by `npm run db:seed-admin` to create the first admin login.
# Change the password after first login, then you can remove these lines.
ADMIN_NAME=BitBrains Admin
ADMIN_EMAIL=admin@bitbrainstech.com
ADMIN_PASSWORD=change_this_password
